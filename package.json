{
  "name": "privos-cluster",
  "version": "0.1.0",
  "description": "Standalone Docker container management microservice for Privos MCP apps",
  "type": "module",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "setup": "tsx scripts/setup-wizard.ts",
    "mcp:rotate-node-identity": "tsx src/cli/rotate-mcp-node-identity.ts",
    "test": "JWT_SECRET=test-secret-0123456789 node --import tsx --test --test-force-exit 'src/**/*.test.ts' 'scripts/**/*.test.ts'",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "start:master": "node --env-file=.env.master dist/master/master-entry.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/websocket": "^11.0.0",
    "dockerode": "^4.0.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "pino": "^9.0.0",
    "undici": "^6.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.29",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.10",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.9.3"
  }
}

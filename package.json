{
  "name": "privos-cluster",
  "version": "0.1.0",
  "description": "Standalone Docker container management microservice for Privos MCP apps",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "test": "JWT_SECRET=test-secret-0123456789 PRIVOS_CHAT_WEBHOOK_URL=http://localhost/hook node --import tsx --test 'src/**/*.test.ts'",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@types/tar": "^7.0.87",
    "better-sqlite3": "^11.0.0",
    "dockerode": "^4.0.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.0.0",
    "tar": "^7.5.15",
    "undici": "^6.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/dockerode": "^3.3.29",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.10",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.9.3"
  }
}

# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Docker
# Linux/macOS: /var/run/docker.sock
# Windows (Docker Desktop): //./pipe/docker_engine — code auto-overrides on win32
# Alternative: set DOCKER_HOST=tcp://host:2375 (dockerode reads it natively)
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=mcp-apps-network

# Auth — HS256 shared secret. The cluster trusts tokens minted by privos-hub
# (issuer 'privos-chat'); set this to the per-cluster secret registered in hub.
JWT_SECRET=change-me-min-16-chars

# Health monitor (in-memory self-restart per privos.health.* labels)
HEALTH_CHECK_INTERVAL_MS=30000

# Reverse-proxy / domains (stateless — configured via env, no settings DB)
# Comma-separated base domains the deploy UI can publish subdomains under.
PRIVOS_DOMAINS=
# Enable caddy-docker-proxy routing (subdomain + domain → published host).
REVERSE_PROXY_ENABLED=false

# Default container resources when a deploy omits them.
DEFAULT_MEMORY_MB=256
DEFAULT_CPUS=0.5
DEFAULT_TMP_MB=64

# CORS — comma-separated origins or '*'. All callers are server-to-server
# (privos-hub), so CORS is effectively unused; leave empty to disable.
CORS_ORIGIN=

# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Docker
# Linux/macOS: /var/run/docker.sock
# Windows (Docker Desktop): //./pipe/docker_engine — code auto-overrides on win32
# Alternative: set DOCKER_HOST=tcp://host:2375 (dockerode reads it natively)
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=mcp-apps-network

# Shared app-fleet hardening. Non-fleet development remains permissive.
FLEET_MODE=false
FLEET_NODE_ID=
FLEET_NODE_KEY=
FLEET_AGENT_CONTAINER=privos-cluster
FLEET_CLUSTER_ID=privos-app-cluster
APP_NETWORK_NAME=
IMAGE_REGISTRY_ALLOWLIST=
CLUSTER_MAX_MEMORY_MB=
CLUSTER_MAX_CPUS=
CLUSTER_OPERATOR_ROUTES=off
MCP_NODE_IDENTITY_KEY_PATH=/var/lib/privos/node-identity.json
MCP_BROKER_ROOT=/run/privos/mcp-broker

# Auth — non-fleet HS256 secret shared with privos-hub (issuer 'privos-chat').
# Fleet agents use FLEET_NODE_ID/FLEET_NODE_KEY instead and accept only
# workspace-scoped tokens minted by privos-apps-master.
JWT_SECRET=change-me-min-16-chars

# Health monitor (in-memory self-restart per privos.health.* labels)
HEALTH_CHECK_INTERVAL_MS=30000

# Reverse-proxy / domains (stateless — configured via env, no settings DB)
# Comma-separated base domains the deploy UI can publish subdomains under.
# Apps MUST be one level deep (whoami.privos.link) — free Cloudflare Universal
# SSL covers a single subdomain level; deeper needs Cloudflare ACM (~$10/mo).
PRIVOS_DOMAINS=
# Legacy caddy gate. Only consulted when REVERSE_PROXY_MODE=caddy.
REVERSE_PROXY_ENABLED=false

# Which reverse proxy fronts apps: off | caddy | native
#   off    — no routing.
#   caddy  — emit caddy-docker-proxy labels; an external Caddy routes (legacy).
#   native — the cluster's own HTTP proxy routes by Host. TLS is terminated by
#            a cloudflared tunnel at the Cloudflare edge — NO certs in the cluster.
#            Requires PRIVOS_DOMAINS. Run `npm run setup` to print the tunnel config.
REVERSE_PROXY_MODE=caddy
# Internal HTTP port the native proxy binds on 127.0.0.1. cloudflared forwards
# `*.<domain> → http://localhost:<PROXY_PORT>`. No public 80/443 on the host.
PROXY_PORT=8080

# Default container resources when a deploy omits them.
DEFAULT_MEMORY_MB=256
DEFAULT_CPUS=0.5
DEFAULT_TMP_MB=64

# CORS — comma-separated origins or '*'. All callers are server-to-server
# (privos-hub), so CORS is effectively unused; leave empty to disable.
CORS_ORIGIN=

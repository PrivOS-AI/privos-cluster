# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Docker
# Linux/macOS: /var/run/docker.sock
# Windows (Docker Desktop): //./pipe/docker_engine — code auto-overrides on win32
# Alternative: set DOCKER_HOST=tcp://host:2375 (dockerode reads it natively)
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=mcp-apps-network

# Database
SQLITE_PATH=./data/cluster.db

# Auth — must match privos-chat CLUSTER_JWT_SECRET
JWT_SECRET=CLUSTER_JWT_SECRET

# Webhook target (privos-chat receiver)
PRIVOS_CHAT_WEBHOOK_URL=http://privos-chat:3000/api/v1/mcp-apps.cluster-event

# Health monitor
HEALTH_CHECK_INTERVAL_MS=30000

# Admin UI (web/) — leave ADMIN_PASSWORD empty to disable the login endpoint
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# CORS — comma-separated origins or '*'. Empty disables CORS entirely.
CORS_ORIGIN=http://localhost:5173
